<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#227EDFFF">

    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <layer-list>

            <!-- Cyan / purple border -->
            <item>
                <shape>
                    <gradient
                        android:angle="315"
                        android:startColor="#91E7FF"
                        android:centerColor="#8794E9"
                        android:endColor="#D49AFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>

            <!-- White card background -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>

        </layer-list>
    </item>

</ripple>