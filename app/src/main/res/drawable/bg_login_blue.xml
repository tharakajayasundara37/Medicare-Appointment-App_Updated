<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1643C7" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#169CF5"
                android:centerColor="#1764F4"
                android:endColor="#2938E7" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="#9DCBFF" />
        </shape>
    </item>

</selector>