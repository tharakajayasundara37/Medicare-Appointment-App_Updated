<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:left="3dp" android:top="4dp">
        <shape>
            <solid android:color="#BDCAE3" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item android:right="3dp" android:bottom="4dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#F0F5FF"
                android:endColor="#D6E1F5" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#EEF4FF" />
        </shape>
    </item>

</layer-list>