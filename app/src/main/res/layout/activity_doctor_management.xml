<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:fillViewport="true"

    android:background="@color/backgroundColor">


    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Doctor Management"

            android:textColor="@color/primaryBlue"

            android:textSize="28sp"

            android:textStyle="bold" />



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Manage doctor applications and active doctors"

            android:textColor="@color/textGray"

            android:textSize="14sp" />




        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:orientation="horizontal">



            <androidx.cardview.widget.CardView

                android:layout_width="0dp"

                android:layout_height="110dp"

                android:layout_weight="1"

                android:layout_margin="5dp">


                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:orientation="vertical">


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Pending"

                        android:textColor="@color/textGray"

                        android:textSize="14sp" />


                    <TextView

                        android:id="@+id/txtPendingDoctorCount"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="0"

                        android:textColor="@color/primaryBlue"

                        android:textSize="28sp"

                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView

                android:layout_width="0dp"

                android:layout_height="110dp"

                android:layout_weight="1"

                android:layout_margin="5dp">


                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:orientation="vertical">


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Approved"

                        android:textColor="@color/textGray"

                        android:textSize="14sp" />


                    <TextView

                        android:id="@+id/txtApprovedDoctorCount"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="0"

                        android:textColor="@color/primaryBlue"

                        android:textSize="28sp"

                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>





            <androidx.cardview.widget.CardView

                android:layout_width="0dp"

                android:layout_height="110dp"

                android:layout_weight="1"

                android:layout_margin="5dp">


                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:orientation="vertical">


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Rejected"

                        android:textColor="@color/textGray"

                        android:textSize="14sp" />


                    <TextView

                        android:id="@+id/txtRejectedDoctorCount"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="0"

                        android:textColor="@color/primaryBlue"

                        android:textSize="28sp"

                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>





        <!-- Filter Buttons -->


        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:orientation="horizontal">



            <Button

                android:id="@+id/btnPendingDoctors"

                android:layout_width="0dp"

                android:layout_height="48dp"

                android:layout_weight="1"

                android:layout_margin="5dp"

                android:text="Pending"

                android:textSize="12sp"

                android:textAllCaps="false"

                android:maxLines="1"

                android:ellipsize="none"

                android:paddingLeft="2dp"

                android:paddingRight="2dp" />





            <Button

                android:id="@+id/btnApprovedDoctors"

                android:layout_width="0dp"

                android:layout_height="48dp"

                android:layout_weight="1"

                android:layout_margin="5dp"

                android:text="Approved"

                android:textSize="12sp"

                android:textAllCaps="false"

                android:maxLines="1"

                android:ellipsize="none"

                android:paddingLeft="2dp"

                android:paddingRight="2dp" />





            <Button

                android:id="@+id/btnRejectedDoctors"

                android:layout_width="0dp"

                android:layout_height="48dp"

                android:layout_weight="1"

                android:layout_margin="5dp"

                android:text="Rejected"

                android:textSize="12sp"

                android:textAllCaps="false"

                android:maxLines="1"

                android:ellipsize="none"

                android:paddingLeft="2dp"

                android:paddingRight="2dp" />


        </LinearLayout>





        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerDoctorManagement"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:nestedScrollingEnabled="false" />


    </LinearLayout>


</ScrollView>