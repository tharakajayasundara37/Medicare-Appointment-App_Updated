<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/backgroundColor">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_soft_card" android:gravity="center" android:text="‹" android:textColor="@color/deepBlue" android:textSize="32sp" />
    <TextView android:id="@+id/txtEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="MEDICARE SERVICES" android:textColor="@color/primaryBlue" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
    <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Find a doctor" android:textColor="@color/textDark" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/textGray" android:textSize="15sp" android:lineSpacingExtra="4dp" />
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:background="@drawable/bg_soft_card" android:hint="Search by doctor, speciality or hospital" android:paddingHorizontal="18dp" android:singleLine="true" android:textColor="@color/textDark" android:textColorHint="@color/textGray" />
    <LinearLayout android:id="@+id/contentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_soft_card" android:orientation="vertical" android:padding="20dp">
      <TextView android:id="@+id/txtCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/textDark" android:textSize="19sp" android:textStyle="bold" />
      <TextView android:id="@+id/txtCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/textGray" android:textSize="14sp" android:lineSpacingExtra="4dp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="How it works" android:textColor="@color/textDark" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_service_teal" android:padding="20dp" android:textColor="@color/deepBlue" android:textSize="14sp" android:lineSpacingExtra="6dp" />
    <Button android:id="@+id/btnPrimaryAction" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="26dp" android:background="@drawable/bg_button_primary" android:text="Continue" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtDisclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Requests are stored on this device. Partner API connection is required for live fulfilment and payments." android:textColor="@color/textGray" android:textSize="11sp" />
  </LinearLayout>
</ScrollView>
