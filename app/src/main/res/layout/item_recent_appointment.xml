<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_soft_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">


    <TextView
        android:id="@+id/txtRecentPatientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textColor="@color/textDark"
        android:textSize="18sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/txtRecentDoctorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Doctor"
        android:textColor="@color/textGray"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/txtRecentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Date"
        android:textColor="@color/textGray"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/txtRecentTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Time"
        android:textColor="@color/textGray"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/txtRecentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status_pending"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:text="Pending"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />


</LinearLayout>