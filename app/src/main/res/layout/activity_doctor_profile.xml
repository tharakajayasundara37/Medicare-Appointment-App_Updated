<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">


    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="24dp">



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Doctor Profile"

            android:textSize="28sp"

            android:textStyle="bold"

            android:textColor="@color/primaryBlue"/>





        <!-- Profile Image Card -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="18dp"

            app:cardElevation="5dp">


            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:gravity="center"

                android:orientation="vertical"

                android:padding="20dp">



                <ImageView

                    android:id="@+id/imgDoctorProfile"

                    android:layout_width="120dp"

                    android:layout_height="120dp"

                    android:src="@drawable/ic_profile"

                    android:scaleType="centerCrop"/>




                <TextView

                    android:id="@+id/txtProfileName"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="15dp"

                    android:text="Doctor Name"

                    android:textSize="22sp"

                    android:textStyle="bold"

                    android:textColor="@color/textDark"/>




                <TextView

                    android:id="@+id/txtProfileSpecialization"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Specialization"

                    android:textSize="16sp"

                    android:textColor="@color/textGray"/>


            </LinearLayout>


        </androidx.cardview.widget.CardView>








        <!-- Personal Details -->


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="18dp"

            app:cardElevation="5dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">


                <TextView

                    android:text="Personal Information"

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:textColor="@color/primaryBlue"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"/>




                <TextView

                    android:id="@+id/txtProfilePhone"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Phone"/>



                <TextView

                    android:id="@+id/txtProfileEmail"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Email"/>



            </LinearLayout>


        </androidx.cardview.widget.CardView>









        <!-- Professional Details -->


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="18dp"

            app:cardElevation="5dp">


            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">



                <TextView

                    android:text="Professional Information"

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:textColor="@color/primaryBlue"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"/>



                <TextView

                    android:id="@+id/txtProfileQualification"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Qualification"/>



                <TextView

                    android:id="@+id/txtProfileRegistration"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Registration Number"/>



                <TextView

                    android:id="@+id/txtProfileExperience"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Experience"/>


            </LinearLayout>


        </androidx.cardview.widget.CardView>









        <!-- Availability -->


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="18dp"

            app:cardElevation="5dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">



                <TextView

                    android:text="Availability"

                    android:textSize="18sp"

                    android:textStyle="bold"

                    android:textColor="@color/primaryBlue"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"/>



                <TextView

                    android:id="@+id/txtProfileWorking"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Working Time"/>



                <TextView

                    android:id="@+id/txtProfileDuration"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Appointment Duration"/>



                <TextView

                    android:id="@+id/txtProfileStatus"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Status"

                    android:textStyle="bold"/>



            </LinearLayout>


        </androidx.cardview.widget.CardView>



    </LinearLayout>


</ScrollView>