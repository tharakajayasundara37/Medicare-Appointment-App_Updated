<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/backgroundColor">


    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">



        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctor Registration" android:textColor="@color/primaryBlue" android:textSize="22sp" android:textStyle="bold" />





        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Submit your application for admin approval" android:textColor="@color/textGray" android:textSize="15sp" />





        
        <ImageView android:id="@+id/imgDoctorProfile" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:layout_marginTop="20dp" android:src="@drawable/ic_profile" android:scaleType="centerCrop" android:background="@drawable/bg_circle_image" android:padding="3dp" />



        <Button android:id="@+id/btnUploadProfileImage" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:text="Upload Profile Image" android:textAllCaps="false" android:backgroundTint="@color/primaryBlue" android:textColor="@color/white" android:textSize="14sp" android:minHeight="48dp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_button_primary" />







        <EditText android:id="@+id/etDoctorName" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="25dp" android:hint="Doctor Name" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etSpecialization" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Specialization" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etDoctorPhone" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Phone Number" android:inputType="phone" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etDoctorEmail" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Email" android:inputType="textEmailAddress" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etDoctorPassword" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Password" android:inputType="textPassword" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <Spinner android:id="@+id/spinnerQualification" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_card" />





        <EditText android:id="@+id/etRegistrationNumber" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Medical Registration Number" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etExperience" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Experience (Years)" android:inputType="number" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <Spinner android:id="@+id/spinnerWorkingDays" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:background="@drawable/bg_soft_card" />





        <EditText android:id="@+id/etStartTime" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Select Start Time" android:focusable="false" android:clickable="true" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <EditText android:id="@+id/etEndTime" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:hint="Select End Time" android:focusable="false" android:clickable="true" android:background="@drawable/bg_input_care" android:padding="16dp" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />





        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Appointment Duration" android:textColor="@color/textGray" />





        <Spinner android:id="@+id/spAppointmentDuration" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="8dp" android:background="@drawable/bg_soft_card" />





        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Qualification Document" android:textColor="@color/textGray" />





        <Button android:id="@+id/btnUploadDocument" android:layout_width="match_parent" android:layout_height="55dp" android:text="Choose Document" android:textAllCaps="false" android:backgroundTint="@color/primaryBlue" android:textColor="@color/white" android:textSize="14sp" android:minHeight="48dp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_button_primary" />





        <TextView android:id="@+id/txtSelectedDocument" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No document selected" android:textColor="@color/textGray" />





        <Button android:id="@+id/btnSubmitDoctor" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="25dp" android:text="Submit Application" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/white" android:backgroundTint="@color/primaryBlue" android:textSize="14sp" android:minHeight="48dp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_button_primary" />




    </LinearLayout>


</ScrollView>