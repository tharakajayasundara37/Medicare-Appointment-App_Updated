<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E4ECF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_login_neumorphic"
            android:gravity="center"
            android:text="+"
            android:textSize="76sp"
            android:textStyle="bold"
            android:textColor="#2159EE"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Welcome Back"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#08143B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sign in to continue"
            android:letterSpacing="0.12"
            android:textSize="14sp"
            android:textColor="#596B90" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_login_neumorphic"
            android:paddingHorizontal="22dp"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#08143B"
            android:textColorHint="#65779B" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_neumorphic"
            android:paddingHorizontal="22dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#08143B"
            android:textColorHint="#65779B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="Account type"
            android:textColor="#596B90"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerRole"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_login_neumorphic"
            android:paddingHorizontal="18dp"
            android:spinnerMode="dropdown"
            android:popupBackground="#E4ECF9" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_login_blue"
            app:backgroundTint="@null"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_neumorphic"
            app:backgroundTint="@null"
            android:text="Create an account"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2159EE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="MEDICARE"
            android:letterSpacing="0.25"
            android:textSize="12sp"
            android:textColor="#65779B" />
    </LinearLayout>
</ScrollView>