<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/backgroundColor">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Register Patient" android:textColor="@color/textDark" android:textSize="22sp" android:textStyle="bold" />

        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Patient Name" android:inputType="textPersonName" android:background="@drawable/bg_input_care" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />

        <EditText android:id="@+id/etAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Age" android:inputType="number" android:background="@drawable/bg_input_care" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />

        <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Phone Number" android:inputType="phone" android:background="@drawable/bg_input_care" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />

        <EditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="top" android:hint="Address" android:inputType="textMultiLine" android:minLines="3" android:background="@drawable/bg_input_care" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />

        <Button android:id="@+id/btnSavePatient" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="30dp" android:backgroundTint="@color/primaryBlue" android:text="Save Patient" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp" android:minHeight="48dp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>