<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_soft_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="18dp">


    <TextView
        android:id="@+id/txtAdminPatientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textColor="@color/textDark"
        android:textSize="20sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/txtAdminDoctorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Doctor"
        android:textColor="@color/textGray"
        android:textSize="15sp" />


    <TextView
        android:id="@+id/txtAdminDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Date"
        android:textColor="@color/textGray"
        android:textSize="15sp" />


    <TextView
        android:id="@+id/txtAdminTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Time"
        android:textColor="@color/textGray"
        android:textSize="15sp" />


    <TextView
        android:id="@+id/txtAdminStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pending"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="Pending"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">


        <Button
            android:id="@+id/btnConfirmAppointment"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:backgroundTint="#4CAF50"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:padding="0dp" />


        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />


        <Button
            android:id="@+id/btnCompleteAppointment"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.2"
            android:backgroundTint="#2196F3"
            android:text="Complete"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:padding="0dp" />


        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />


        <Button
            android:id="@+id/btnCancelAppointment"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:backgroundTint="#F44336"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:padding="0dp" />


    </LinearLayout>


</LinearLayout>