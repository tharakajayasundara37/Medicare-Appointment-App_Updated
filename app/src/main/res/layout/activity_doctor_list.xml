<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/backgroundColor" android:padding="20dp">


    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find Doctors" android:textColor="@color/textDark" android:textSize="22sp" android:textStyle="bold" />


    <EditText android:id="@+id/etSearchDoctor" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:hint="Search doctor or specialization" android:padding="15dp" android:background="@drawable/bg_input_care" android:textColor="@color/textDark" android:textColorHint="@color/textGray" android:textSize="14sp" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />


    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerDoctors" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="15dp" />


</LinearLayout>